# ═══════════════════════════════════════════
# KnitSys Backend - Variables de Entorno
# ═══════════════════════════════════════════
# Copia este archivo como .env y completa con tus datos de TiDB Cloud

# ═══ Puerto del servidor ═══
PORT=3001

# ═══ Configuración de TiDB Cloud ═══
# Puedes obtener estos datos desde el dashboard de TiDB Cloud
# Cluster → Connect → Connection String

TIDB_HOST=gateway01.xxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxx.root
TIDB_PASSWORD=tu_password_aqui
TIDB_DATABASE=test
TIDB_SSL=true

# ═══ JWT Secret (para autenticación) ═══
JWT_SECRET=tu_secret_muy_seguro_aqui_cambia_esto

# ═══ CORS (orígenes permitidos) ═══
# En producción, cambia * por tu dominio de Vercel
FRONTEND_URL=http://localhost:5173

# ═══ Node Environment ═══
NODE_ENV=development