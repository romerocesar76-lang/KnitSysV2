# Desarrollo: proxy Vite → http://localhost:3001/api (ajusta VITE_API_URL si cambias el puerto del backend)
# Si el backend corre en otro puerto, usa una URL completa:
# VITE_API_URL=http://localhost:3003/api
VITE_API_URL=/api

# Producción: URL completa del backend
# VITE_API_URL=https://tu-backend.com/api
